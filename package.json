{
  "name": "annota",
  "version": "0.10.5",
  "type": "module",
  "description": "An annotation framework for React and Svelte",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts && pnpm build:svelte",
    "build:svelte": "svelte-package -i src/svelte -o dist/svelte",
    "build:docs": "pnpm build && cd docs && pnpm install --no-frozen-lockfile && pnpm build",
    "start:docs": "cd docs && pnpm preview",
    "dev": "pnpm run dev:lib & pnpm run dev:docs",
    "dev:lib": "pnpm build --watch",
    "dev:docs": "cd docs && pnpm dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "keywords": [
    "pathology",
    "annotation",
    "openseadragon",
    "whole-slide-imaging",
    "digital-pathology",
    "react",
    "cell-counting"
  ],
  "author": "BitRoc Lab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitroc-ai/annota.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./svelte": {
      "types": "./src/svelte/index.ts",
      "svelte": "./src/svelte/index.ts",
      "default": "./src/svelte/index.ts"
    },
    "./dist/index.css": "./dist/index.css"
  },
  "peerDependencies": {
    "openseadragon": "^4.0.0 || ^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "jsfive": "^0.4.0",
    "npyjs": "^1.0.4",
    "pako": "^2.1.0",
    "pixi.js": "^8.14.0",
    "polygon-clipping": "^0.15.7",
    "rbush": "^4.0.1",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/openseadragon": "^3.0.10",
    "@types/pako": "^2.0.4",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/ui": "^4.0.2",
    "jsdom": "^27.0.1",
    "onnxruntime-node": "^1.23.2",
    "svelte": "^5.46.1",
    "svelte-check": "^4.3.5",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.2"
  }
}
