{
  "name": "annota",
  "version": "1.0.0",
  "type": "module",
  "description": "An annotation framework for React and Svelte",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "tsup --config tsup.config.ts && pnpm build:svelte",
    "build:svelte": "svelte-package -i src/svelte -o dist/svelte",
    "build:docs": "pnpm build && cd docs && pnpm install --no-frozen-lockfile && pnpm build",
    "start:docs": "cd docs && pnpm preview",
    "dev": "pnpm run dev:lib & pnpm run dev:docs",
    "dev:lib": "pnpm run dev:lib:ts & pnpm run dev:lib:svelte",
    "dev:lib:ts": "tsup --config tsup.config.ts --watch",
    "dev:lib:svelte": "svelte-package -i src/svelte -o dist/svelte --watch",
    "dev:docs": "cd docs && pnpm dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:browser": "vitest run test/integration/browser-lifecycle.test.ts",
    "test:frameworks": "vitest run test/integration/framework-lifecycle.test.tsx test/integration/svelte-lifecycle.test.ts",
    "test:consumer": "node scripts/test-package-consumers.mjs",
    "check:docs-imports": "node scripts/check-doc-imports.mjs",
    "benchmark": "node benchmarks/annota-benchmark.mjs",
    "benchmark:ci": "pnpm build && node benchmarks/annota-benchmark.mjs --ci"
  },
  "keywords": [
    "pathology",
    "annotation",
    "openseadragon",
    "whole-slide-imaging",
    "digital-pathology",
    "react",
    "cell-counting"
  ],
  "author": "BitRoc Lab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitroc-ai/annota.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./legacy-react": {
      "types": "./dist/legacy-react.d.ts",
      "import": "./dist/legacy-react.js",
      "require": "./dist/legacy-react.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js",
      "require": "./dist/tools.cjs"
    },
    "./loaders": {
      "types": "./dist/loaders.d.ts",
      "import": "./dist/loaders.js",
      "require": "./dist/loaders.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./dist/index.css": "./dist/styles.css"
  },
  "peerDependencies": {
    "openseadragon": "^4.0.0 || ^5.0.0 || ^6.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "sideEffects": [
    "*.css",
    "dist/*.css"
  ],
  "dependencies": {
    "jsfive": "^0.4.0",
    "npyjs": "^1.1.0",
    "pako": "^2.1.0",
    "pixi.js": "^8.18.1",
    "polygon-clipping": "^0.15.7",
    "rbush": "^4.0.1",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@astrojs/compiler": "3.0.1",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/openseadragon": "^5.0.2",
    "@types/pako": "^2.0.4",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/ui": "^4.1.5",
    "jsdom": "^29.0.2",
    "onnxruntime-node": "^1.24.3",
    "svelte": "^5.55.4",
    "svelte-check": "^4.4.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.9",
    "vitest": "^4.1.5"
  }
}
