<div class="nextra-steps ml-4 mb-12 border-l border-gray-200 dark:border-neutral-800 pl-6 [counter-reset:step]">
  <slot />
</div>

<style is:global>
  .nextra-steps h3 {
    counter-increment: step;
    position: relative;
  }
  .nextra-steps h3::before {
    content: counter(step);
    position: absolute;
    left: -2.4rem;
    top: 50%;
    transform: translateY(-50%);
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    background-color: white;
    border: 1px solid #e5e7eb;
    color: #6b7280;
    text-align: center;
    line-height: 2rem;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .dark .nextra-steps h3::before {
    background-color: #0f172a;
    border-color: #262626;
    color: #a3a3a3;
  }
</style>

