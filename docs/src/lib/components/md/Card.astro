---
import DynamicIcon from "./DynamicIcon.svelte";

interface Props {
  title: string;
  iconName?: string;
  href: string;
}

const { title, iconName, href } = Astro.props;
const currentPath = Astro.url.pathname;
const isActive = currentPath === href || currentPath.startsWith(href + "/");
---

<a
  href={href}
  class="group flex flex-col justify-start overflow-hidden rounded-lg border no-underline shadow-sm transition-all duration-200 hover:shadow-md card-link {isActive ? 'card-link-active' : ''}"
  style="border-color: var(--border); background-color: var(--background);"
>
  {iconName && (
    <div class="p-4" style="color: var(--muted-foreground);">
      <DynamicIcon client:load name={iconName} class="w-6 h-6" />
    </div>
  )}
  <div class="flex-1 p-4 pt-0">
    <div class="font-semibold" style="color: var(--foreground);">{title}</div>
    <slot />
  </div>
</a>

