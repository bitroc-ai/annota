---
interface Props {
  type?: "default" | "info" | "warning" | "error" | "success";
  emoji?: string;
}

const { type = "default", emoji } = Astro.props;

const icons = {
  default: "ℹ️",
  info: "ℹ️",
  warning: "⚠️",
  error: "❌",
  success: "✅",
};

// Color mappings using CSS variables for theme adaptation
const colorStyles: Record<string, { bg: string; text: string; border: string }> = {
  default: {
    bg: "color-mix(in srgb, #fb923c 10%, var(--background))",
    text: "var(--foreground)",
    border: "color-mix(in srgb, #fb923c 30%, var(--border))",
  },
  info: {
    bg: "color-mix(in srgb, #3b82f6 10%, var(--background))",
    text: "var(--foreground)",
    border: "color-mix(in srgb, #3b82f6 30%, var(--border))",
  },
  warning: {
    bg: "color-mix(in srgb, #eab308 10%, var(--background))",
    text: "var(--foreground)",
    border: "color-mix(in srgb, #eab308 30%, var(--border))",
  },
  error: {
    bg: "color-mix(in srgb, #ef4444 10%, var(--background))",
    text: "var(--foreground)",
    border: "color-mix(in srgb, #ef4444 30%, var(--border))",
  },
  success: {
    bg: "color-mix(in srgb, #22c55e 10%, var(--background))",
    text: "var(--foreground)",
    border: "color-mix(in srgb, #22c55e 30%, var(--border))",
  },
};

const style = colorStyles[type];
---

<div
  class="overflow-x-auto mt-6 flex rounded-lg border py-4 pr-4 pl-3"
  style={`background-color: ${style.bg}; color: ${style.text}; border-color: ${style.border};`}
>
  <div class="select-none text-xl ltr:mr-3 rtl:ml-3 pl-1">
    {emoji || icons[type]}
  </div>
  <div class="w-full min-w-0 leading-7">
    <slot />
  </div>
</div>

