---
interface Props {
  items: Array<{ label: string; icon: string }>;
}

const { items } = Astro.props;
---

<div class="framework-tabs mt-4" data-framework-tabs>
  <div class="flex gap-4 justify-center mb-6">
    {items.map((item, i) => (
      <button
        type="button"
        class="framework-tab-button px-8 py-4 text-lg font-semibold rounded-xl transition-all duration-200 border-2 flex items-center gap-3"
        data-framework-tab-button
        data-index={i}
        role="tab"
        aria-selected={i === 0}
        style="border-color: var(--border); background-color: var(--background); color: var(--muted-foreground);"
      >
        <span class="framework-tab-icon" set:html={item.icon}></span>
        <span>{item.label}</span>
      </button>
    ))}
  </div>

  <div>
    <slot />
  </div>
</div>

<script>
  function setupFrameworkTabs() {
    const tabContainers = document.querySelectorAll('[data-framework-tabs]');
    
    tabContainers.forEach(container => {
      const buttons = container.querySelectorAll('[data-framework-tab-button]');
      const panels = container.querySelectorAll('[data-framework-tab-panel]');
      
      function setTab(index) {
        buttons.forEach((btn, i) => {
          const isSelected = i === index;
          btn.setAttribute('aria-selected', isSelected.toString());
          
          const icon = btn.querySelector('.framework-tab-icon');
          
          if (isSelected) {
            btn.style.borderColor = 'var(--primary)';
            btn.style.backgroundColor = 'color-mix(in srgb, var(--primary) 10%, transparent)';
            btn.style.color = 'var(--primary)';
            btn.style.transform = 'scale(1.02)';
            btn.style.boxShadow = '0 4px 12px color-mix(in srgb, var(--primary) 20%, transparent)';
            if (icon) {
              icon.style.filter = 'grayscale(0%)';
            }
          } else {
            btn.style.borderColor = 'var(--border)';
            btn.style.backgroundColor = 'var(--background)';
            btn.style.color = 'var(--muted-foreground)';
            btn.style.transform = 'scale(1)';
            btn.style.boxShadow = 'none';
            if (icon) {
              icon.style.filter = 'grayscale(100%)';
            }
          }
        });
        
        panels.forEach((panel, i) => {
          if (i === index) {
            panel.classList.remove('hidden');
          } else {
            panel.classList.add('hidden');
          }
        });
      }
      
      buttons.forEach((btn, i) => {
        btn.addEventListener('click', () => setTab(i));
      });
      
      // Initialize first tab and set grayscale for inactive tabs
      if (buttons.length > 0) {
        buttons.forEach((btn, i) => {
          const icon = btn.querySelector('.framework-tab-icon');
          if (i === 0) {
            if (icon) {
              icon.style.filter = 'grayscale(0%)';
            }
          } else {
            if (icon) {
              icon.style.filter = 'grayscale(100%)';
            }
          }
        });
        setTab(0);
      }
    });
  }

  // Run on initial load
  setupFrameworkTabs();
  // Run on View Transitions navigation
  document.addEventListener('astro:after-swap', setupFrameworkTabs);
</script>

<style>
  .framework-tab-icon {
    display: inline-flex;
    align-items: center;
    width: 24px;
    height: 24px;
    transition: filter 0.2s ease-in-out;
  }
  
  .framework-tab-icon svg {
    width: 100%;
    height: 100%;
  }
  
  .framework-tab-button[aria-selected="false"] .framework-tab-icon {
    filter: grayscale(100%);
  }
  
  .framework-tab-button[aria-selected="true"] .framework-tab-icon {
    filter: grayscale(0%);
  }
</style>

