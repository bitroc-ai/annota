---
import BaseLayout from './BaseLayout.astro';
import DocsLayoutComponent from '../lib/components/layout/DocsLayout.svelte';

interface Props {
  title?: string;
  frontmatter?: {
    title?: string;
  };
}

const { title, frontmatter } = Astro.props;
const displayTitle = title || frontmatter?.title;
const currentPath = Astro.url.pathname;
---

<BaseLayout title={displayTitle}>
  <DocsLayoutComponent client:load currentPath={currentPath}>
    <div class="prose max-w-none">
      <slot />
    </div>
  </DocsLayoutComponent>
</BaseLayout>

