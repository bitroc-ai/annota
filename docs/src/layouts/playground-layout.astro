---
/**
 * Minimal layout for the Playground page
 * Uses Starlight's theme system for consistent theming
 */
import "../app.css"; // Include Tailwind for the Playground component
import ThemeSwitcher from "../lib/components/theme-switcher.svelte";

interface Props {
  title?: string;
}

const { title = "Playground" } = Astro.props;

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/getting-started/installation", label: "Docs" },
  { href: "/playground", label: "Playground" },
  { href: "/api", label: "API" },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" data-theme>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Annota Playground - Interactive annotation demo"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Annota</title>
    <script>
      // Sync theme with Starlight's theme system
      function initTheme() {
        const theme = localStorage.getItem("starlight-theme") ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
        if (theme === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      }

      initTheme();

      // Listen for theme changes from Starlight (storage event from other tabs)
      window.addEventListener("storage", (e) => {
        if (e.key === "starlight-theme") {
          initTheme();
        }
      });

      // Listen for theme changes from same page (custom event)
      window.addEventListener("theme-change", () => {
        initTheme();
      });
    </script>
  </head>
  <body>
    <div class="layout">
      <header class="header">
        <div class="header-left">
          <a href="/" class="logo">
            <svg
              width="22"
              height="22"
              viewBox="0 0 32 32"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <rect
                x="2"
                y="2"
                width="28"
                height="28"
                rx="6"
                stroke="currentColor"
                stroke-width="2.5"
                fill="none"></rect>
              <circle cx="16" cy="16" r="6" fill="currentColor"></circle>
            </svg>
            <span>Annota</span>
          </a>
          <nav>
            {
              navLinks.map((link) => (
                <a
                  href={link.href}
                  class:list={{
                    active:
                      currentPath === link.href ||
                      (link.href !== "/" && currentPath.startsWith(link.href)),
                  }}
                >
                  {link.label}
                </a>
              ))
            }
          </nav>
        </div>
        <div class="header-right">
          <ThemeSwitcher client:load />
          <a
            href="https://github.com/bitroc-ai/annota"
            target="_blank"
            rel="noreferrer"
            class="github"
            aria-label="GitHub"
          >
            <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor">
              <path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
              ></path>
            </svg>
          </a>
        </div>
      </header>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  /* Starlight CSS variables - matching Starlight's theme */
  :root {
    --sl-color-bg: #ffffff;
    --sl-color-bg-nav: #f8f9fa;
    --sl-color-text: #1e293b;
    --sl-color-gray-2: #64748b;
    --sl-color-gray-6: #e2e8f0;
    --sl-color-hairline: #e2e8f0;
  }

  .dark {
    --sl-color-bg: #0a0a0a;
    --sl-color-bg-nav: #0f0f0f;
    --sl-color-text: #fafafa;
    --sl-color-gray-2: #a1a1aa;
    --sl-color-gray-6: #27272a;
    --sl-color-hairline: #27272a;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html,
  body {
    height: 100%;
  }

  body {
    font-family:
      -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans", Helvetica,
      Arial, sans-serif;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .layout {
    display: flex;
    flex-direction: column;
    height: 100vh;
  }

  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
    padding-inline: 1.5rem;
    background: var(--sl-color-bg-nav);
    border-bottom: 1px solid var(--sl-color-hairline);
    backdrop-filter: blur(12px);
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  @media (min-width: 1024px) {
    .header {
      padding-inline: 2.5rem;
    }
  }

  @media (min-width: 1280px) {
    .header {
      padding-inline: 3rem;
    }
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--sl-color-text);
    text-decoration: none;
    letter-spacing: -0.025em;
    transition: color 0.15s ease;
  }

  .logo svg {
    opacity: 0.9;
    transition: opacity 0.15s ease;
  }

  .logo:hover {
    color: var(--sl-color-text);
  }

  .logo:hover svg {
    opacity: 1;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  nav a {
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
    border-radius: 0.375rem;
  }

  nav a:hover {
    color: var(--sl-color-text);
    background: var(--sl-color-gray-6);
  }

  nav a.active {
    color: var(--sl-color-text);
    background: var(--sl-color-gray-6);
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .github {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--sl-color-gray-2);
    border-radius: 0.5rem;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .github:hover {
    color: var(--sl-color-text);
    background: var(--sl-color-gray-6);
  }

  main {
    flex: 1;
    overflow: hidden;
  }
</style>
