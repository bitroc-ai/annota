---
interface Props {
  title?: string;
  frontmatter?: {
    title?: string;
  };
}

const { title, frontmatter } = Astro.props;
const displayTitle = title || frontmatter?.title;
---

<div class="docs-layout">
  {displayTitle && <h1 class="docs-title">{displayTitle}</h1>}
  <div class="prose max-w-none">
    <slot />
  </div>
</div>

<style>
  .docs-layout {
    width: 100%;
    padding: 2rem 1.5rem;
  }

  .docs-title {
    margin-bottom: 1rem;
  }
</style>
