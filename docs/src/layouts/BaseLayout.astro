---
import Navbar from '../lib/components/layout/Navbar.svelte';
import '../app.css';

interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="bg-white dark:bg-[#0a0f1a]">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Annota - High-performance annotation framework for digital pathology" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title || 'Annota Documentation'}</title>
    <script is:inline>
      // Prevent flash of wrong theme
      (function() {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (stored === "dark" || (!stored && prefersDark)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-white dark:bg-[#0a0f1a] font-sans antialiased text-slate-900 dark:text-slate-100">
    <Navbar client:load />
    <slot />
  </body>
</html>


