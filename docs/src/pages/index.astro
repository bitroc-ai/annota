---
import '../app.css';
import FeatureCard from "../lib/components/landing/feature-card.svelte";
import Footer from "../lib/components/landing/footer.svelte";
import AnnotaDemo from "../lib/components/demo/annota-demo.svelte";
import FrameworkTabs from "../lib/components/landing/framework-tabs.astro";
import FrameworkTab from "../lib/components/landing/framework-tab.astro";
import Code from "../lib/components/md/code.astro";
import ThemeSwitcher from "../lib/components/theme-switcher.svelte";
import { ChevronRight } from "lucide-svelte";

// SVG logos for Svelte and React
const svelteIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="107" height="128" viewBox="0 0 107 128"><title>svelte-logo</title><path d="M94.1566,22.8189c-10.4-14.8851-30.94-19.2971-45.7914-9.8348L22.2825,29.6078A29.9234,29.9234,0,0,0,8.7639,49.6506a31.5136,31.5136,0,0,0,3.1076,20.2318A30.0061,30.0061,0,0,0,7.3953,81.0653a31.8886,31.8886,0,0,0,5.4473,24.1157c10.4022,14.8865,30.9423,19.2966,45.7914,9.8348L84.7167,98.3921A29.9177,29.9177,0,0,0,98.2353,78.3493,31.5263,31.5263,0,0,0,95.13,58.117a30,30,0,0,0,4.4743-11.1824,31.88,31.88,0,0,0-5.4473-24.1157" style="fill:#ff3e00"/><path d="M45.8171,106.5815A20.7182,20.7182,0,0,1,23.58,98.3389a19.1739,19.1739,0,0,1-3.2766-14.5025,18.1886,18.1886,0,0,1,.6233-2.4357l.4912-1.4978,1.3363.9815a33.6443,33.6443,0,0,0,10.203,5.0978l.9694.2941-.0893.9675a5.8474,5.8474,0,0,0,1.052,3.8781,6.2389,6.2389,0,0,0,6.6952,2.485,5.7449,5.7449,0,0,0,1.6021-.7041L69.27,76.281a5.4306,5.4306,0,0,0,2.4506-3.631,5.7948,5.7948,0,0,0-.9875-4.3712,6.2436,6.2436,0,0,0-6.6978-2.4864,5.7427,5.7427,0,0,0-1.6.7036l-9.9532,6.3449a19.0329,19.0329,0,0,1-5.2965,2.3259,20.7181,20.7181,0,0,1-22.2368-8.2427,19.1725,19.1725,0,0,1-3.2766-14.5024,17.9885,17.9885,0,0,1,8.13-12.0513L55.8833,23.7472a19.0038,19.0038,0,0,1,5.3-2.3287A20.7182,20.7182,0,0,1,83.42,29.6611a19.1739,19.1739,0,0,1,3.2766,14.5025,18.4,18.4,0,0,1-.6233,2.4357l-.4912,1.4978-1.3356-.98a33.6175,33.6175,0,0,0-10.2037-5.1l-.9694-.2942.0893-.9675a5.8588,5.8588,0,0,0-1.052-3.878,6.2389,6.2389,0,0,0-6.6952-2.485,5.7449,5.7449,0,0,0-1.6021.7041L37.73,51.719a5.4218,5.4218,0,0,0-2.4487,3.63,5.7862,5.7862,0,0,0,.9856,4.3717,6.2437,6.2437,0,0,0,6.6978,2.4864,5.7652,5.7652,0,0,0,1.602-.7041l9.9519-6.3425a18.978,18.978,0,0,1,5.2959-2.3278,20.7181,20.7181,0,0,1,22.2368,8.2427,19.1725,19.1725,0,0,1,3.2766,14.5024,17.9977,17.9977,0,0,1-8.13,12.0532L51.1167,104.2528a19.0038,19.0038,0,0,1-5.3,2.3287" style="fill:#fff"/></svg>`;

const reactIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="-11.5 -10.23174 23 20.46348"><title>React Logo</title><circle cx="0" cy="0" r="2.05" fill="#61dafb"/><g stroke="#61dafb" stroke-width="1" fill="none"><ellipse rx="11" ry="4.2"/><ellipse rx="11" ry="4.2" transform="rotate(60)"/><ellipse rx="11" ry="4.2" transform="rotate(120)"/></g></svg>`;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/getting-started/installation', label: 'Docs' },
  { href: '/playground', label: 'Playground' },
  { href: '/api', label: 'API' },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" data-theme>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Annota - High-performance annotation framework for whole slide imaging and digital pathology" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Annota | High-performance annotation framework</title>
    <script>
      // Sync theme with Starlight's theme system
      function initTheme() {
        const theme = localStorage.getItem('starlight-theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      }

      initTheme();

      // Listen for theme changes from Starlight (storage event from other tabs)
      window.addEventListener('storage', (e) => {
        if (e.key === 'starlight-theme') {
          initTheme();
        }
      });

      // Listen for theme changes from same page (custom event)
      window.addEventListener('theme-change', () => {
        initTheme();
      });
    </script>
  </head>
  <body>
    <div class="layout">
      <header class="header">
        <div class="header-left">
          <a href="/" class="logo">
            <svg width="22" height="22" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="2" y="2" width="28" height="28" rx="6" stroke="currentColor" stroke-width="2.5" fill="none"/>
              <circle cx="16" cy="16" r="6" fill="currentColor"/>
            </svg>
            <span>Annota</span>
          </a>
          <nav>
            {navLinks.map(link => (
              <a 
                href={link.href}
                class:list={{ active: currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) }}
              >
                {link.label}
              </a>
            ))}
          </nav>
        </div>
        <div class="header-right">
          <ThemeSwitcher client:load />
          <a href="https://github.com/bitroc-ai/annota" target="_blank" rel="noreferrer" class="github" aria-label="GitHub">
            <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
            </svg>
          </a>
        </div>
      </header>
      <main>
        <!-- Hero Section -->
        <section class="hero">
          <div class="hero-content">
            <h1 class="hero-title">Annota</h1>
            <p class="hero-tagline">
              High-performance annotation framework for whole slide imaging and digital pathology
            </p>
            <div class="hero-actions">
              <a href="/getting-started/installation/" class="btn-primary">
                Get Started
                <ChevronRight class="icon" />
              </a>
              <a href="/playground/" class="btn-secondary">
                Playground
              </a>
            </div>
          </div>
        </section>

        <!-- Features Section -->
        <section class="features">
          <div class="container">
            <h2 class="section-title">Why Choose Annota?</h2>
            <div class="features-grid">
              <FeatureCard
                client:load
                iconName="Zap"
                title="High Performance"
                description="60 FPS rendering with hardware acceleration, viewport culling, and R-tree spatial indexing"
              />
              <FeatureCard
                client:load
                iconName="Code2"
                title="Svelte & React"
                description="Works seamlessly with both Svelte 5 and React 18+. Choose the framework that fits your stack"
              />
              <FeatureCard
                client:load
                iconName="Layers"
                title="Multi-Layer Support"
                description="Organize annotations into layers with independent visibility, opacity, and styling controls"
              />
              <FeatureCard
                client:load
                iconName="Package"
                title="Comprehensive Tools"
                description="Point, rectangle, polygon, freehand, and SAM segmentation tools out of the box"
              />
              <FeatureCard
                client:load
                iconName="Microscope"
                title="Pathology-Focused"
                description="Built specifically for whole slide imaging and digital pathology workflows"
              />
              <FeatureCard
                client:load
                iconName="Brain"
                title="Event-Driven"
                description="Comprehensive event system for responding to annotation changes in real-time"
              />
            </div>
          </div>
        </section>

        <!-- Interactive Demo Section -->
        <section class="demo">
          <div class="container">
            <div class="demo-content">
              <h2 class="section-title">Try It Now</h2>
              <p class="demo-description">
                Interactive demo: Click and drag to draw a rectangle annotation, or
                select and resize the existing one.
              </p>
              <div class="demo-wrapper">
                <AnnotaDemo client:load />
              </div>
            </div>
          </div>
        </section>

        <!-- Quick Start Section -->
        <section class="quickstart">
          <div class="container">
            <div class="quickstart-content">
              <h2 class="section-title">Quick Start</h2>
              <FrameworkTabs
                items={[
                  { label: "Svelte", icon: svelteIcon },
                  { label: "React", icon: reactIcon },
                ]}
              >
                <FrameworkTab>
                  <div class="code-wrapper">
                    <Code
                      code={`import { AnnotaProvider, Viewer, Annotator, tool } from 'annota/svelte';
import { RectangleTool } from 'annota';

<script lang="ts">
  import { AnnotaProvider, Viewer, Annotator, tool } from 'annota/svelte';
  import { RectangleTool } from 'annota';
  
  let viewer: OpenSeadragon.Viewer | undefined = $state(undefined);
  const rectangleTool = new RectangleTool();
  
  tool({
    viewer: () => viewer,
    handler: () => rectangleTool,
    enabled: () => !!viewer,
  });
</script>

<AnnotaProvider slideId="my-slide">
  <Viewer
    options={{ tileSources: "/image.dzi" }}
    onViewerReady={(v) => viewer = v}
  />
  <Annotator viewer={viewer} />
</AnnotaProvider>`}
                      lang="svelte"
                    />
                  </div>
                </FrameworkTab>
                <FrameworkTab>
                  <div class="code-wrapper">
                    <Code
                      code={`import { AnnotaProvider, AnnotaViewer, Annotator } from 'annota';
import { useTool } from 'annota';
import { RectangleTool } from 'annota';
import { useState } from 'react';

function App() {
  const [viewer, setViewer] = useState(null);
  const rectangleTool = new RectangleTool();
  
  useTool({
    viewer,
    handler: rectangleTool,
    enabled: !!viewer,
  });

  return (
    <AnnotaProvider slideId="my-slide">
      <AnnotaViewer
        options={{ tileSources: "/image.dzi" }}
        onViewerReady={setViewer}
      />
      <Annotator viewer={viewer} />
    </AnnotaProvider>
  );
}`}
                      lang="tsx"
                    />
                  </div>
                </FrameworkTab>
              </FrameworkTabs>
              <div class="quickstart-link">
                <a href="/getting-started/quick-start/" class="link">
                  Read the full guide
                  <ChevronRight class="icon" />
                </a>
              </div>
            </div>
          </div>
        </section>

        <!-- CTA Section -->
        <section class="cta">
          <div class="container">
            <h2 class="cta-title">Ready to Start Annotating?</h2>
            <p class="cta-description">
              Build powerful annotation tools for digital pathology with Annota's
              comprehensive framework
            </p>
            <div class="cta-actions">
              <a href="/getting-started/installation/" class="btn-primary">
                Read Documentation
                <ChevronRight class="icon" />
              </a>
              <a href="/api/" class="btn-secondary">
                API
              </a>
            </div>
          </div>
        </section>

        <Footer client:load />
      </main>
    </div>
  </body>
</html>

<style>
  /* Starlight CSS variables - matching Starlight's theme */
  :root {
    --sl-color-bg: #ffffff;
    --sl-color-bg-nav: #f8f9fa;
    --sl-color-text: #1e293b;
    --sl-color-gray-2: #64748b;
    --sl-color-gray-6: #e2e8f0;
    --sl-color-hairline: #e2e8f0;
    --sl-color-accent: #3b82f6;
    --sl-color-white: #ffffff;
  }
  
  .dark {
    --sl-color-bg: #0a0a0a;
    --sl-color-bg-nav: #0f0f0f;
    --sl-color-text: #fafafa;
    --sl-color-gray-2: #a1a1aa;
    --sl-color-gray-6: #27272a;
    --sl-color-hairline: #27272a;
    --sl-color-accent: #60a5fa;
    --sl-color-white: #ffffff;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html, body {
    height: 100%;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .layout {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
    padding-inline: 1.5rem;
    background: var(--sl-color-bg-nav);
    border-bottom: 1px solid var(--sl-color-hairline);
    backdrop-filter: blur(12px);
    transition: background-color 0.2s ease, border-color 0.2s ease;
    position: sticky;
    top: 0;
    z-index: 50;
  }

  @media (min-width: 1024px) {
    .header {
      padding-inline: 2.5rem;
    }
  }

  @media (min-width: 1280px) {
    .header {
      padding-inline: 3rem;
    }
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--sl-color-text);
    text-decoration: none;
    letter-spacing: -0.025em;
    transition: color 0.15s ease;
  }

  .logo svg {
    opacity: 0.9;
    transition: opacity 0.15s ease;
  }

  .logo:hover {
    color: var(--sl-color-text);
  }

  .logo:hover svg {
    opacity: 1;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  nav a {
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    transition: color 0.15s ease, background-color 0.15s ease;
    border-radius: 0.375rem;
  }

  nav a:hover {
    color: var(--sl-color-text);
    background: var(--sl-color-gray-6);
  }

  nav a.active {
    color: var(--sl-color-text);
    background: var(--sl-color-gray-6);
  }

  .github {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--sl-color-gray-2);
    border-radius: 0.5rem;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .github:hover {
    color: var(--sl-color-text);
    background: var(--sl-color-gray-6);
  }

  main {
    flex: 1;
  }

  /* Hero Section */
  .hero {
    padding: 6rem 1.5rem;
    text-align: center;
    background: var(--sl-color-bg);
  }

  .hero-content {
    max-width: 48rem;
    margin: 0 auto;
  }

  .hero-title {
    font-size: 4rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--sl-color-text);
    margin-bottom: 1.5rem;
  }

  .hero-tagline {
    font-size: 1.25rem;
    line-height: 1.75;
    color: var(--sl-color-gray-2);
    margin-bottom: 2.5rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--sl-color-white);
    background: var(--sl-color-accent);
    border-radius: 0.5rem;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .btn-primary:hover {
    opacity: 0.9;
  }

  .btn-primary .icon {
    width: 1rem;
    height: 1rem;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--sl-color-text);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .btn-secondary:hover {
    background: var(--sl-color-gray-6);
  }

  /* Features Section */
  .features {
    padding: 5rem 1.5rem;
    background: var(--sl-color-bg);
  }

  .container {
    max-width: 80rem;
    margin: 0 auto;
  }

  .section-title {
    font-size: 2.5rem;
    font-weight: 700;
    text-align: center;
    color: var(--sl-color-text);
    margin-bottom: 3rem;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  /* Demo Section */
  .demo {
    padding: 5rem 1.5rem;
    background: var(--sl-color-gray-6);
  }

  .demo-content {
    max-width: 64rem;
    margin: 0 auto;
  }

  .demo-description {
    text-align: center;
    color: var(--sl-color-gray-2);
    margin-bottom: 2rem;
  }

  .demo-wrapper {
    border-radius: 0.5rem;
    overflow: hidden;
    border: 1px solid var(--sl-color-hairline);
    background: var(--sl-color-bg);
    padding: 1rem;
    height: 500px;
    position: relative;
  }

  .demo-wrapper :global(> *) {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Quick Start Section */
  .quickstart {
    padding: 5rem 1.5rem;
    background: var(--sl-color-bg);
  }

  .quickstart-content {
    max-width: 48rem;
    margin: 0 auto;
  }

  .code-wrapper {
    padding: 0;
    background: transparent;
    border: none;
    overflow: visible;
  }

  .quickstart-link {
    text-align: center;
    margin-top: 2rem;
  }

  .link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--sl-color-accent);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .link:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  .link .icon {
    width: 1rem;
    height: 1rem;
  }

  /* CTA Section */
  .cta {
    padding: 4rem 1.5rem;
    background: linear-gradient(to bottom right, var(--sl-color-accent), color-mix(in srgb, var(--sl-color-accent) 80%, var(--sl-color-bg)));
    text-align: center;
  }

  .cta-title {
    font-size: 2.5rem;
    font-weight: 600;
    color: var(--sl-color-white);
    margin-bottom: 1rem;
  }

  .cta-description {
    font-size: 1rem;
    color: var(--sl-color-white);
    opacity: 0.9;
    margin-bottom: 2rem;
    max-width: 36rem;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.5rem;
    }

    .section-title {
      font-size: 2rem;
    }

    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
