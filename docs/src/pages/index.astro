---
import '../app.css';
import SharedHeader from '../components/shared-header.astro';
import FrameworkTabs from '../lib/components/landing/framework-tabs.astro';
import FrameworkTab from '../lib/components/landing/framework-tab.astro';
import Code from '../lib/components/md/code.astro';

const currentPath = Astro.url.pathname;
const features = [
  {
    title: 'High Performance',
    description:
      '60 FPS rendering with hardware acceleration, viewport culling, and R-tree spatial indexing.',
  },
  {
    title: 'Dual Framework',
    description:
      'First-class APIs for both React and Svelte with parallel docs and examples.',
  },
  {
    title: 'Multi-Layer Support',
    description:
      'Organize annotations by layer with independent visibility, opacity, and styles.',
  },
  {
    title: 'Comprehensive Tools',
    description: 'Rectangle, polygon, brush, point, and SAM-assisted annotation tools out of the box.',
  },
  {
    title: 'Pathology-Focused',
    description: 'Designed for whole slide imaging and digital pathology datasets at scale.',
  },
  {
    title: 'Event-Driven',
    description: 'Observe annotation lifecycle events to integrate analytics and workflow automation.',
  },
];
const svelteIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="107" height="128" viewBox="0 0 107 128"><title>svelte-logo</title><path d="M94.1566,22.8189c-10.4-14.8851-30.94-19.2971-45.7914-9.8348L22.2825,29.6078A29.9234,29.9234,0,0,0,8.7639,49.6506a31.5136,31.5136,0,0,0,3.1076,20.2318A30.0061,30.0061,0,0,0,7.3953,81.0653a31.8886,31.8886,0,0,0,5.4473,24.1157c10.4022,14.8865,30.9423,19.2966,45.7914,9.8348L84.7167,98.3921A29.9177,29.9177,0,0,0,98.2353,78.3493,31.5263,31.5263,0,0,0,95.13,58.117a30,30,0,0,0,4.4743-11.1824,31.88,31.88,0,0,0-5.4473-24.1157" style="fill:#ff3e00"/><path d="M45.8171,106.5815A20.7182,20.7182,0,0,1,23.58,98.3389a19.1739,19.1739,0,0,1-3.2766-14.5025,18.1886,18.1886,0,0,1,.6233-2.4357l.4912-1.4978,1.3363.9815a33.6443,33.6443,0,0,0,10.203,5.0978l.9694.2941-.0893.9675a5.8474,5.8474,0,0,0,1.052,3.8781,6.2389,6.2389,0,0,0,6.6952,2.485,5.7449,5.7449,0,0,0,1.6021-.7041L69.27,76.281a5.4306,5.4306,0,0,0,2.4506-3.631,5.7948,5.7948,0,0,0-.9875-4.3712,6.2436,6.2436,0,0,0-6.6978-2.4864,5.7427,5.7427,0,0,0-1.6.7036l-9.9532,6.3449a19.0329,19.0329,0,0,1-5.2965,2.3259,20.7181,20.7181,0,0,1-22.2368-8.2427,19.1725,19.1725,0,0,1-3.2766-14.5024,17.9885,17.9885,0,0,1,8.13-12.0513L55.8833,23.7472a19.0038,19.0038,0,0,1,5.3-2.3287A20.7182,20.7182,0,0,1,83.42,29.6611a19.1739,19.1739,0,0,1,3.2766,14.5025,18.4,18.4,0,0,1-.6233,2.4357l-.4912,1.4978-1.3356-.98a33.6175,33.6175,0,0,0-10.2037-5.1l-.9694-.2942.0893-.9675a5.8588,5.8588,0,0,0-1.052-3.878,6.2389,6.2389,0,0,0-6.6952-2.485,5.7449,5.7449,0,0,0-1.6021.7041L37.73,51.719a5.4218,5.4218,0,0,0-2.4487,3.63,5.7862,5.7862,0,0,0,.9856,4.3717,6.2437,6.2437,0,0,0,6.6978,2.4864,5.7652,5.7652,0,0,0,1.602-.7041l9.9519-6.3425a18.978,18.978,0,0,1,5.2959-2.3278,20.7181,20.7181,0,0,1,22.2368,8.2427,19.1725,19.1725,0,0,1,3.2766,14.5024,17.9977,17.9977,0,0,1-8.13,12.0532L51.1167,104.2528a19.0038,19.0038,0,0,1-5.3,2.3287" style="fill:#fff"/></svg>`;
const reactIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="-11.5 -10.23174 23 20.46348"><circle cx="0" cy="0" r="2.05" fill="#61dafb"/><g stroke="#61dafb" stroke-width="1" fill="none"><ellipse rx="11" ry="4.2"/><ellipse rx="11" ry="4.2" transform="rotate(60)"/><ellipse rx="11" ry="4.2" transform="rotate(120)"/></g></svg>`;
---

<!doctype html>
<html lang="en" data-theme>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Annota - High-performance annotation framework for whole slide imaging and digital pathology"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Annota | React + Svelte Annotation Framework</title>
  </head>
  <body>
    <div class="layout">
      <SharedHeader currentPath={currentPath} />
      <main>
        <section class="hero">
          <div class="hero-content">
            <h1 class="hero-title">Annota</h1>
            <p class="hero-tagline">
              High-performance annotation framework for whole slide imaging and digital pathology.
            </p>
            <div class="hero-actions">
              <a href="/getting-started/installation/" class="btn-primary">Get Started</a>
              <a href="/playground/" class="btn-secondary">Playground</a>
            </div>
          </div>
        </section>

        <section class="features">
          <div class="container">
            <h2 class="section-title">Why Annota</h2>
            <div class="features-grid">
              {features.map((feature) => (
                <article class="feature-card">
                  <h3>{feature.title}</h3>
                  <p>{feature.description}</p>
                </article>
              ))}
            </div>
          </div>
        </section>

        <section class="quickstart">
          <div class="container quickstart-content">
            <h2 class="section-title">Quick Start</h2>
            <FrameworkTabs items={[{ label: 'React', icon: reactIcon }, { label: 'Svelte', icon: svelteIcon }]}>
              <FrameworkTab>
                <Code
                  code={`import { AnnotaProvider, AnnotaViewer, Annotator, useTool } from 'annota';
import { RectangleTool } from 'annota';
import { useState } from 'react';

function App() {
  const [viewer, setViewer] = useState(null);
  const rectangleTool = new RectangleTool();

  useTool({
    viewer,
    handler: rectangleTool,
    enabled: !!viewer,
  });

  return (
    <AnnotaProvider>
      <AnnotaViewer
        options={{ tileSources: '/image.dzi' }}
        onViewerReady={setViewer}
      />
      <Annotator viewer={viewer} />
    </AnnotaProvider>
  );
}`}
                  lang="tsx"
                />
              </FrameworkTab>
              <FrameworkTab>
                <Code
                  code={`<script lang="ts">
  import { AnnotaProvider, Viewer, Annotator, tool } from 'annota/svelte';
  import { RectangleTool } from 'annota';
  import type OpenSeadragon from 'openseadragon';

  let viewer: OpenSeadragon.Viewer | undefined = $state(undefined);
  const rectangleTool = new RectangleTool();

  tool({
    viewer: () => viewer,
    handler: () => rectangleTool,
    enabled: () => !!viewer,
  });
</script>

<AnnotaProvider>
  <Viewer
    options={{ tileSources: '/image.dzi' }}
    onViewerReady={(v) => (viewer = v)}
  />
  <Annotator {viewer} />
</AnnotaProvider>`}
                  lang="svelte"
                />
              </FrameworkTab>
            </FrameworkTabs>
            <p class="quickstart-link">
              <a href="/getting-started/quick-start/">Read the full guide</a>
            </p>
          </div>
        </section>

        <footer class="footer">
          <div class="container footer-inner">
            <p>Built by BitRoc Lab.</p>
            <a href="https://github.com/bitroc-ai/annota" target="_blank" rel="noreferrer">GitHub</a>
          </div>
        </footer>
      </main>
    </div>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
  }

  .layout {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }

  .hero,
  .features,
  .quickstart {
    padding: 4rem 1.5rem;
  }

  .hero {
    text-align: center;
  }

  .hero-content {
    max-width: 48rem;
    margin: 0 auto;
  }

  .hero-title {
    font-size: clamp(2.5rem, 7vw, 4rem);
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .hero-tagline {
    color: var(--sl-color-gray-2);
    font-size: 1.125rem;
    margin-bottom: 1.75rem;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    border-radius: 0.5rem;
    padding: 0.75rem 1.2rem;
    font-weight: 600;
    border: 1px solid transparent;
  }

  .btn-primary {
    background: var(--sl-color-accent);
    color: var(--sl-color-white);
  }

  .btn-secondary {
    border-color: var(--sl-color-hairline);
    color: var(--sl-color-text);
  }

  .container {
    max-width: 76rem;
    margin: 0 auto;
  }

  .section-title {
    text-align: center;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    margin-bottom: 2rem;
  }

  .features-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .feature-card {
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    padding: 1rem;
    background: color-mix(in srgb, var(--sl-color-bg) 96%, var(--sl-color-accent) 4%);
  }

  .feature-card h3 {
    margin-bottom: 0.5rem;
    font-size: 1rem;
  }

  .feature-card p {
    color: var(--sl-color-gray-2);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  .quickstart-content {
    max-width: 56rem;
  }

  .quickstart-link {
    margin-top: 1rem;
    text-align: center;
  }

  .quickstart-link a {
    color: var(--sl-color-accent);
    text-decoration: none;
    font-weight: 600;
  }

  .footer {
    border-top: 1px solid var(--sl-color-hairline);
    padding: 1rem 1.5rem;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-size: 0.9rem;
    color: var(--sl-color-gray-2);
  }

  .footer a {
    color: var(--sl-color-text);
    text-decoration: none;
  }
</style>
