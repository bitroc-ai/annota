---
import "../app.css";
import SharedHeader from "../components/shared-header.astro";
import FrameworkTabs from "../lib/components/landing/framework-tabs.astro";
import FrameworkTab from "../lib/components/landing/framework-tab.astro";
import HeroDemo from "../lib/components/landing/hero-demo";
import Code from "../lib/components/md/code.astro";

const currentPath = Astro.url.pathname;
const currentYear = new Date().getFullYear();

const metrics = [
  { value: "60 FPS", label: "Interactive Rendering" },
  { value: "5 Core Tools", label: "Annotation Modes" },
  { value: "React + Svelte", label: "Framework Support" },
  { value: "WSI Ready", label: "Pathology Scale" },
];

const features = [
  {
    title: "Slide-Scale Performance",
    description:
      "Pan, zoom, and annotate large whole-slide imagery with predictable interaction and high rendering throughput.",
  },
  {
    title: "Operational Layer Controls",
    description:
      "Organize work into independent layers with lock state, visibility, opacity control, and export-level separation.",
  },
  {
    title: "Production Toolchain",
    description:
      "Move fluidly across point, polygon, rectangle, curve, split, and SAM-assisted segmentation in one workspace.",
  },
  {
    title: "Integration Surface",
    description:
      "Use annotation lifecycle events and structured exports to plug into QA, analytics, and downstream automation.",
  },
  {
    title: "Framework Parity",
    description:
      "Build against aligned APIs in React and Svelte with equivalent concepts, examples, and runtime behavior.",
  },
  {
    title: "Pathology-Focused Defaults",
    description:
      "Designed around real pathology constraints instead of generic drawing demos or one-off proof-of-concepts.",
  },
];

const workflow = [
  {
    title: "Ingest and Navigate",
    description:
      "Load high-resolution imagery and maintain stable viewport control for clinical annotation sessions.",
  },
  {
    title: "Annotate with Precision",
    description:
      "Switch tools instantly while preserving context, layer boundaries, and editing consistency.",
  },
  {
    title: "Export and Automate",
    description:
      "Deliver structured outputs and event signals directly into your review and model pipelines.",
  },
];

const svelteIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="107" height="128" viewBox="0 0 107 128"><title>svelte-logo</title><path d="M94.1566,22.8189c-10.4-14.8851-30.94-19.2971-45.7914-9.8348L22.2825,29.6078A29.9234,29.9234,0,0,0,8.7639,49.6506a31.5136,31.5136,0,0,0,3.1076,20.2318A30.0061,30.0061,0,0,0,7.3953,81.0653a31.8886,31.8886,0,0,0,5.4473,24.1157c10.4022,14.8865,30.9423,19.2966,45.7914,9.8348L84.7167,98.3921A29.9177,29.9177,0,0,0,98.2353,78.3493,31.5263,31.5263,0,0,0,95.13,58.117a30,30,0,0,0,4.4743-11.1824,31.88,31.88,0,0,0-5.4473-24.1157" style="fill:#ff3e00"/><path d="M45.8171,106.5815A20.7182,20.7182,0,0,1,23.58,98.3389a19.1739,19.1739,0,0,1-3.2766-14.5025,18.1886,18.1886,0,0,1,.6233-2.4357l.4912-1.4978,1.3363.9815a33.6443,33.6443,0,0,0,10.203,5.0978l.9694.2941-.0893.9675a5.8474,5.8474,0,0,0,1.052,3.8781,6.2389,6.2389,0,0,0,6.6952,2.485,5.7449,5.7449,0,0,0,1.6021-.7041L69.27,76.281a5.4306,5.4306,0,0,0,2.4506-3.631,5.7948,5.7948,0,0,0-.9875-4.3712,6.2436,6.2436,0,0,0-6.6978-2.4864,5.7427,5.7427,0,0,0-1.6.7036l-9.9532,6.3449a19.0329,19.0329,0,0,1-5.2965,2.3259,20.7181,20.7181,0,0,1-22.2368-8.2427,19.1725,19.1725,0,0,1-3.2766-14.5024,17.9885,17.9885,0,0,1,8.13-12.0513L55.8833,23.7472a19.0038,19.0038,0,0,1,5.3-2.3287A20.7182,20.7182,0,0,1,83.42,29.6611a19.1739,19.1739,0,0,1,3.2766,14.5025,18.4,18.4,0,0,1-.6233,2.4357l-.4912,1.4978-1.3356-.98a33.6175,33.6175,0,0,0-10.2037-5.1l-.9694-.2942.0893-.9675a5.8588,5.8588,0,0,0-1.052-3.878,6.2389,6.2389,0,0,0-6.6952-2.485,5.7449,5.7449,0,0,0-1.6021.7041L37.73,51.719a5.4218,5.4218,0,0,0-2.4487,3.63,5.7862,5.7862,0,0,0,.9856,4.3717,6.2437,6.2437,0,0,0,6.6978,2.4864,5.7652,5.7652,0,0,0,1.602-.7041l9.9519-6.3425a18.978,18.978,0,0,1,5.2959-2.3278,20.7181,20.7181,0,0,1,22.2368,8.2427,19.1725,19.1725,0,0,1,3.2766,14.5024,17.9977,17.9977,0,0,1-8.13,12.0532L51.1167,104.2528a19.0038,19.0038,0,0,1-5.3,2.3287" style="fill:#fff"/></svg>`;
const reactIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="-11.5 -10.23174 23 20.46348"><circle cx="0" cy="0" r="2.05" fill="#61dafb"/><g stroke="#61dafb" stroke-width="1" fill="none"><ellipse rx="11" ry="4.2"/><ellipse rx="11" ry="4.2" transform="rotate(60)"/><ellipse rx="11" ry="4.2" transform="rotate(120)"/></g></svg>`;
---

<!doctype html>
<html lang="en" data-theme>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Annota - High-performance annotation framework for whole slide imaging and digital pathology"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Annota | Precision Annotation Infrastructure</title>
  </head>
  <body>
    <div class="layout landing-root">
      <SharedHeader currentPath={currentPath} />
      <main class="landing-page">
        <section class="landing-hero">
          <div class="hero-grid-overlay" aria-hidden="true"></div>
          <div class="hero-glow hero-glow-left" aria-hidden="true"></div>
          <div class="hero-glow hero-glow-right" aria-hidden="true"></div>

          <div class="container landing-hero-layout">
            <div class="hero-copy">
              <p class="hero-eyebrow">
                Open-Source Pathology Annotation Toolkit
              </p>
              <h1>Open Annotation for Whole-Slide Workflows</h1>
              <p class="hero-description">
                Annota is a community-driven toolkit for building precise,
                high-performance annotation workflows with React or Svelte.
              </p>
              <div class="hero-actions">
                <a
                  href="/getting-started/installation/"
                  class="hero-btn hero-btn-primary">Get Started</a
                >
                <a href="/playground/" class="hero-btn hero-btn-secondary"
                  >Open Playground</a
                >
              </div>
            </div>

            <aside class="hero-stage" aria-label="Workspace preview">
              <div class="stage-window">
                <div class="stage-canvas">
                  <HeroDemo client:only="react">
                    <div slot="fallback" class="stage-canvas-fallback">
                      Loading live demo canvas...
                    </div>
                  </HeroDemo>
                </div>
              </div>
            </aside>
          </div>

          <div class="container metrics-strip" aria-label="Key metrics">
            {
              metrics.map((item) => (
                <article class="metric-tile">
                  <p class="metric-value">{item.value}</p>
                  <p class="metric-label">{item.label}</p>
                </article>
              ))
            }
          </div>
        </section>

        <section class="landing-section landing-section-features">
          <div class="container">
            <h2 class="landing-section-title">
              Built in the Open for Real Annotation Work
            </h2>
            <p class="landing-section-subtitle">
              The project focuses on practical workflows, maintainable APIs, and
              transparent design decisions that contributors can reason about
              and extend.
            </p>
            <div class="feature-grid">
              {
                features.map((feature, index) => (
                  <article class="feature-card">
                    <span class="feature-index">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <h3>{feature.title}</h3>
                    <p>{feature.description}</p>
                  </article>
                ))
              }
            </div>
          </div>
        </section>

        <section class="landing-section workflow-band">
          <div class="container">
            <h2 class="landing-section-title">
              From Slide Ingestion to Structured Output
            </h2>
            <div class="workflow-grid">
              {
                workflow.map((step, index) => (
                  <article class="workflow-card">
                    <span class="workflow-step">Step {index + 1}</span>
                    <h3>{step.title}</h3>
                    <p>{step.description}</p>
                  </article>
                ))
              }
            </div>
          </div>
        </section>

        <section class="landing-section landing-section-quickstart">
          <div class="container quickstart-shell">
            <div class="quickstart-head">
              <h2 class="landing-section-title">Quick Start</h2>
              <p class="landing-section-subtitle">
                Start quickly in either framework with the same core concepts
                and predictable tool integration model.
              </p>
            </div>
            <FrameworkTabs
              items={[
                { label: "React", icon: reactIcon },
                { label: "Svelte", icon: svelteIcon },
              ]}
            >
              <FrameworkTab>
                <Code
                  code={`import { AnnotaProvider, Viewer as AnnotaViewer, Annotator, useTool } from 'annota/react';
import { RectangleTool } from 'annota/tools';
import { useState } from 'react';

function App() {
  const [viewer, setViewer] = useState(null);
  const rectangleTool = new RectangleTool();

  useTool({
    viewer,
    handler: rectangleTool,
    enabled: !!viewer,
  });

  return (
    <AnnotaProvider>
      <AnnotaViewer
        options={{ tileSources: '/image.dzi' }}
        onViewerReady={setViewer}
      />
      <Annotator viewer={viewer} />
    </AnnotaProvider>
  );
}`}
                  lang="tsx"
                />
              </FrameworkTab>
              <FrameworkTab>
                <Code
                  code={`<script lang="ts">
  import { AnnotaProvider, Viewer, Annotator, tool } from 'annota/svelte';
  import { RectangleTool } from 'annota/tools';
  import type OpenSeadragon from 'openseadragon';

  let viewer: OpenSeadragon.Viewer | undefined = $state(undefined);
  const rectangleTool = new RectangleTool();

  tool({
    viewer: () => viewer,
    handler: () => rectangleTool,
    enabled: () => !!viewer,
  });
</script>

<AnnotaProvider>
  <Viewer
    options={{ tileSources: '/image.dzi' }}
    onViewerReady={(v) => (viewer = v)}
  />
  <Annotator {viewer} />
</AnnotaProvider>`}
                  lang="svelte"
                />
              </FrameworkTab>
            </FrameworkTabs>
            <p class="quickstart-link">
              <a href="/getting-started/quick-start/">Read the full guide</a>
            </p>
          </div>
        </section>

        <footer class="landing-footer">
          <div class="container landing-footer-main">
            <section class="landing-footer-brand-block">
              <a href="/" class="landing-footer-logo" aria-label="Annota home">
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 32 32"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <rect
                    x="2"
                    y="2"
                    width="28"
                    height="28"
                    rx="6"
                    stroke="currentColor"
                    stroke-width="2.5"
                    fill="none"></rect>
                  <circle cx="16" cy="16" r="6" fill="currentColor"></circle>
                </svg>
                <span>Annota</span>
              </a>
              <p class="landing-footer-copy">
                Open-source pathology annotation toolkit for digital pathology
                teams shipping production annotation workflows.
              </p>
              <a
                href="https://github.com/bitroc-ai/annota"
                class="landing-footer-cta"
                target="_blank"
                rel="noreferrer">Star on GitHub</a
              >
            </section>

            <nav class="landing-footer-col" aria-label="Popular links">
              <p class="landing-footer-col-title">Popular Links</p>
              <ul class="landing-footer-list">
                <li>
                  <a href="/getting-started/installation/">Installation</a>
                </li>
                <li><a href="/getting-started/quick-start/">Quick Start</a></li>
                <li><a href="/playground/">Playground</a></li>
                <li><a href="/guides/tools/">Tools Guide</a></li>
              </ul>
            </nav>

            <nav class="landing-footer-col" aria-label="Developer links">
              <p class="landing-footer-col-title">Developers</p>
              <ul class="landing-footer-list">
                <li><a href="/api/">API Reference</a></li>
                <li><a href="/guides/integration/">Integration Guide</a></li>
                <li><a href="/changelog/">Changelog</a></li>
                <li>
                  <a
                    href="https://github.com/bitroc-ai/annota"
                    target="_blank"
                    rel="noreferrer">GitHub Repository</a
                  >
                </li>
              </ul>
            </nav>
          </div>
          <div class="container landing-footer-bottom">
            <p>© {currentYear} BitRoc Lab</p>
            <p>MIT Licensed</p>
          </div>
        </footer>
      </main>
    </div>
  </body>
</html>

<style is:global>
  .landing-page {
    --landing-bg: #f3f6fc;
    --landing-text: #0f172a;
    --landing-muted: #52607a;
    --landing-card: #ffffff;
    --landing-card-2: #f1f5ff;
    --landing-border: #d8e2f0;
    --landing-accent: #1e40af;
    --landing-accent-2: #0f766e;
    --landing-shadow: 0 22px 46px -30px rgba(15, 23, 42, 0.32);
    background: var(--landing-bg);
    color: var(--landing-text);
    min-height: 100%;
  }

  html.dark .landing-page {
    --landing-bg: #090f1c;
    --landing-text: #e6edf8;
    --landing-muted: #a2afc5;
    --landing-card: #0f1b32;
    --landing-card-2: #182946;
    --landing-border: #2a3d5b;
    --landing-accent: #4f7dff;
    --landing-accent-2: #2dd4bf;
    --landing-shadow: 0 28px 58px -36px rgba(2, 7, 18, 0.85);
  }

  .landing-root {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .landing-page .container {
    width: min(1200px, calc(100% - 2.5rem));
    margin-inline: auto;
  }

  .landing-hero {
    position: relative;
    overflow: hidden;
    padding: 5.5rem 0 3.25rem;
    border-bottom: 1px solid var(--landing-border);
    background:
      radial-gradient(
        circle at 10% -6%,
        rgba(96, 165, 250, 0.2),
        transparent 34%
      ),
      radial-gradient(
        circle at 95% 110%,
        rgba(45, 212, 191, 0.16),
        transparent 30%
      ),
      linear-gradient(180deg, #eaf0fb, #dde8f8 52%, #d7e3f6);
    color: var(--landing-text);
  }

  html.dark .landing-hero {
    border-bottom-color: #2c405f;
    background:
      radial-gradient(
        circle at 12% -4%,
        rgba(96, 165, 250, 0.18),
        transparent 34%
      ),
      radial-gradient(
        circle at 95% 108%,
        rgba(45, 212, 191, 0.14),
        transparent 30%
      ),
      linear-gradient(145deg, #0b1426, #122543 45%, #0f1f38);
  }

  .hero-grid-overlay {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(108, 129, 168, 0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgba(108, 129, 168, 0.12) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.5), transparent 86%);
    pointer-events: none;
  }

  .hero-glow {
    position: absolute;
    width: 360px;
    height: 360px;
    border-radius: 999px;
    filter: blur(72px);
    opacity: 0.42;
    pointer-events: none;
  }

  .hero-glow-left {
    top: -140px;
    left: -110px;
    background: rgba(30, 64, 175, 0.55);
  }

  .hero-glow-right {
    right: -150px;
    bottom: -170px;
    background: rgba(15, 118, 110, 0.52);
  }

  .landing-hero-layout {
    position: relative;
    display: grid;
    gap: 1.8rem;
    align-items: center;
  }

  .hero-copy h1 {
    font-family: "Avenir Next", "Segoe UI", "Helvetica Neue", sans-serif;
    font-weight: 760;
    letter-spacing: -0.03em;
    line-height: 1.02;
    font-size: clamp(2.4rem, 6.2vw, 4.35rem);
    max-width: 12ch;
    margin-bottom: 1.1rem;
    color: #0f1e3c;
    text-wrap: balance;
  }

  html.dark .hero-copy h1 {
    color: #e8f1ff;
    text-shadow: 0 1px 10px rgba(6, 14, 30, 0.36);
  }

  .hero-eyebrow {
    width: fit-content;
    color: #2141a1;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.88;
    margin-bottom: 1rem;
  }

  html.dark .hero-eyebrow {
    color: #a9c2ff;
  }

  .hero-description {
    color: color-mix(in oklab, var(--landing-text) 76%, #3f5c93);
    font-size: clamp(1.04rem, 1.45vw, 1.2rem);
    line-height: 1.68;
    max-width: 58ch;
    margin-bottom: 1.5rem;
  }

  .hero-actions {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.8rem;
    padding: 0.78rem 1.28rem;
    font-weight: 700;
    text-decoration: none;
    border: 1px solid transparent;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      background-color 0.15s ease;
  }

  .hero-btn:hover {
    transform: translateY(-1px);
  }

  .hero-btn-primary {
    color: #f8fbff;
    background: linear-gradient(132deg, #3f6ded, #365ee7);
    box-shadow: 0 10px 20px -14px rgba(79, 125, 255, 0.52);
  }

  .hero-btn-secondary {
    color: #1f335f;
    border-color: rgba(67, 97, 179, 0.34);
    background: rgba(248, 251, 255, 0.76);
  }

  html.dark .hero-btn-secondary {
    color: #e5ecff;
    border-color: rgba(148, 163, 184, 0.4);
    background: rgba(15, 26, 47, 0.72);
  }

  .hero-stage {
    display: block;
  }

  .stage-window {
    border: 1px solid rgba(191, 213, 255, 0.4);
    border-radius: 1rem;
    background: rgba(248, 251, 255, 0.93);
    box-shadow: var(--landing-shadow);
    color: #0f172a;
  }

  .stage-window {
    overflow: hidden;
    backdrop-filter: blur(8px);
  }

  .stage-canvas {
    position: relative;
    height: 440px;
    min-height: 440px;
    background:
      radial-gradient(circle at 18% 12%, #dbe8ff, transparent 55%),
      radial-gradient(circle at 83% 87%, #bfdbfe, transparent 45%),
      linear-gradient(140deg, #f8fbff, #edf2ff 56%, #e8f5ff);
    overflow: hidden;
  }

  html.dark .stage-canvas {
    background:
      radial-gradient(circle at 20% 16%, #1e3a5f, transparent 55%),
      radial-gradient(circle at 85% 86%, #104355, transparent 45%),
      linear-gradient(145deg, #132033, #121f35 52%, #102130);
  }

  .stage-canvas-fallback {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    color: var(--landing-muted);
  }

  .metrics-strip {
    margin-top: 1.45rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem;
  }

  .metric-tile {
    border: 1px solid rgba(191, 213, 255, 0.42);
    border-radius: 0.85rem;
    background: rgba(248, 251, 255, 0.9);
    box-shadow: var(--landing-shadow);
    padding: 0.74rem 0.8rem;
    backdrop-filter: blur(8px);
    color: #0f172a;
  }

  .metric-value {
    font-family: "Avenir Next", "Segoe UI", sans-serif;
    font-size: 0.95rem;
    font-weight: 760;
    margin-bottom: 0.1rem;
  }

  .metric-label {
    color: var(--landing-muted);
    font-size: 0.75rem;
    line-height: 1.34;
  }

  .landing-section {
    padding: 4.5rem 0;
  }

  .landing-section-features {
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.32),
      rgba(255, 255, 255, 0.02)
    );
  }

  .landing-section-quickstart {
    background: linear-gradient(
      180deg,
      rgba(148, 163, 184, 0.08),
      rgba(148, 163, 184, 0.03)
    );
  }

  html.dark .landing-section-features {
    background: linear-gradient(
      180deg,
      rgba(30, 41, 59, 0.36),
      rgba(17, 24, 39, 0.08)
    );
  }

  html.dark .landing-section-quickstart {
    background: linear-gradient(
      180deg,
      rgba(15, 23, 42, 0.5),
      rgba(15, 23, 42, 0.2)
    );
  }

  .workflow-band {
    background: linear-gradient(
      180deg,
      rgba(79, 125, 255, 0.12),
      rgba(45, 212, 191, 0.06)
    );
    border-top: 1px solid var(--landing-border);
    border-bottom: 1px solid var(--landing-border);
  }

  .landing-section-title {
    font-family: "Avenir Next", "Segoe UI", sans-serif;
    font-weight: 760;
    letter-spacing: -0.02em;
    font-size: clamp(1.75rem, 2.75vw, 2.6rem);
    line-height: 1.14;
    margin-bottom: 0.88rem;
    text-align: center;
  }

  .landing-section-subtitle {
    width: min(760px, 100%);
    margin: 0 auto 2rem;
    color: var(--landing-muted);
    text-align: center;
    line-height: 1.65;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 0.9rem;
  }

  .feature-card {
