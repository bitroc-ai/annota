---
import '../app.css';
import SharedHeader from '../components/shared-header.astro';
import FrameworkTabs from '../lib/components/landing/framework-tabs.astro';
import FrameworkTab from '../lib/components/landing/framework-tab.astro';
import Code from '../lib/components/md/code.astro';

const currentPath = Astro.url.pathname;
const features = [
  {
    title: 'High Performance',
    description:
      '60 FPS rendering with hardware acceleration, viewport culling, and R-tree spatial indexing.',
  },
  {
    title: 'React-First',
    description:
      'First-class React APIs with hooks and components for production annotation workflows.',
  },
  {
    title: 'Multi-Layer Support',
    description:
      'Organize annotations by layer with independent visibility, opacity, and styles.',
  },
  {
    title: 'Comprehensive Tools',
    description: 'Rectangle, polygon, brush, point, and SAM-assisted annotation tools out of the box.',
  },
  {
    title: 'Pathology-Focused',
    description: 'Designed for whole slide imaging and digital pathology datasets at scale.',
  },
  {
    title: 'Event-Driven',
    description: 'Observe annotation lifecycle events to integrate analytics and workflow automation.',
  },
];
const reactIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="-11.5 -10.23174 23 20.46348"><circle cx="0" cy="0" r="2.05" fill="#61dafb"/><g stroke="#61dafb" stroke-width="1" fill="none"><ellipse rx="11" ry="4.2"/><ellipse rx="11" ry="4.2" transform="rotate(60)"/><ellipse rx="11" ry="4.2" transform="rotate(120)"/></g></svg>`;
---

<!doctype html>
<html lang="en" data-theme>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Annota - High-performance annotation framework for whole slide imaging and digital pathology"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Annota | React Annotation Framework</title>
  </head>
  <body>
    <div class="layout">
      <SharedHeader currentPath={currentPath} />
      <main>
        <section class="hero">
          <div class="hero-content">
            <h1 class="hero-title">Annota</h1>
            <p class="hero-tagline">
              High-performance annotation framework for whole slide imaging and digital pathology.
            </p>
            <div class="hero-actions">
              <a href="/getting-started/installation/" class="btn-primary">Get Started</a>
              <a href="/playground/" class="btn-secondary">Playground</a>
            </div>
          </div>
        </section>

        <section class="features">
          <div class="container">
            <h2 class="section-title">Why Annota</h2>
            <div class="features-grid">
              {features.map((feature) => (
                <article class="feature-card">
                  <h3>{feature.title}</h3>
                  <p>{feature.description}</p>
                </article>
              ))}
            </div>
          </div>
        </section>

        <section class="quickstart">
          <div class="container quickstart-content">
            <h2 class="section-title">React Quick Start</h2>
            <FrameworkTabs items={[{ label: 'React', icon: reactIcon }]}>
              <FrameworkTab>
                <Code
                  code={`import { AnnotaProvider, AnnotaViewer, Annotator, useTool } from 'annota';
import { RectangleTool } from 'annota';
import { useState } from 'react';

function App() {
  const [viewer, setViewer] = useState(null);
  const rectangleTool = new RectangleTool();

  useTool({
    viewer,
    handler: rectangleTool,
    enabled: !!viewer,
  });

  return (
    <AnnotaProvider slideId="my-slide">
      <AnnotaViewer
        options={{ tileSources: '/image.dzi' }}
        onViewerReady={setViewer}
      />
      <Annotator viewer={viewer} />
    </AnnotaProvider>
  );
}`}
                  lang="tsx"
                />
              </FrameworkTab>
            </FrameworkTabs>
            <p class="quickstart-link">
              <a href="/getting-started/quick-start/react/">Read the full guide</a>
            </p>
          </div>
        </section>

        <footer class="footer">
          <div class="container footer-inner">
            <p>Built by BitRoc Lab.</p>
            <a href="https://github.com/bitroc-ai/annota" target="_blank" rel="noreferrer">GitHub</a>
          </div>
        </footer>
      </main>
    </div>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
  }

  .layout {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }

  .hero,
  .features,
  .quickstart {
    padding: 4rem 1.5rem;
  }

  .hero {
    text-align: center;
  }

  .hero-content {
    max-width: 48rem;
    margin: 0 auto;
  }

  .hero-title {
    font-size: clamp(2.5rem, 7vw, 4rem);
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .hero-tagline {
    color: var(--sl-color-gray-2);
    font-size: 1.125rem;
    margin-bottom: 1.75rem;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    border-radius: 0.5rem;
    padding: 0.75rem 1.2rem;
    font-weight: 600;
    border: 1px solid transparent;
  }

  .btn-primary {
    background: var(--sl-color-accent);
    color: var(--sl-color-white);
  }

  .btn-secondary {
    border-color: var(--sl-color-hairline);
    color: var(--sl-color-text);
  }

  .container {
    max-width: 76rem;
    margin: 0 auto;
  }

  .section-title {
    text-align: center;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    margin-bottom: 2rem;
  }

  .features-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .feature-card {
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    padding: 1rem;
    background: color-mix(in srgb, var(--sl-color-bg) 96%, var(--sl-color-accent) 4%);
  }

  .feature-card h3 {
    margin-bottom: 0.5rem;
    font-size: 1rem;
  }

  .feature-card p {
    color: var(--sl-color-gray-2);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  .quickstart-content {
    max-width: 56rem;
  }

  .quickstart-link {
    margin-top: 1rem;
    text-align: center;
  }

  .quickstart-link a {
    color: var(--sl-color-accent);
    text-decoration: none;
    font-weight: 600;
  }

  .footer {
    border-top: 1px solid var(--sl-color-hairline);
    padding: 1rem 1.5rem;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-size: 0.9rem;
    color: var(--sl-color-gray-2);
  }

  .footer a {
    color: var(--sl-color-text);
    text-decoration: none;
  }
</style>
