---
import BaseLayout from "../layouts/BaseLayout.astro";
import FeatureCard from "../lib/components/landing/FeatureCard.svelte";
import Footer from "../lib/components/landing/Footer.svelte";
import AnnotaDemo from "../lib/components/demo/AnnotaDemo.svelte";
import FrameworkTabs from "../lib/components/landing/FrameworkTabs.astro";
import FrameworkTab from "../lib/components/landing/FrameworkTab.astro";
import Code from "../lib/components/md/Code.astro";
import { ChevronRight, MonitorPlay } from "lucide-svelte";

// SVG logos for Svelte and React
const svelteIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="107" height="128" viewBox="0 0 107 128"><title>svelte-logo</title><path d="M94.1566,22.8189c-10.4-14.8851-30.94-19.2971-45.7914-9.8348L22.2825,29.6078A29.9234,29.9234,0,0,0,8.7639,49.6506a31.5136,31.5136,0,0,0,3.1076,20.2318A30.0061,30.0061,0,0,0,7.3953,81.0653a31.8886,31.8886,0,0,0,5.4473,24.1157c10.4022,14.8865,30.9423,19.2966,45.7914,9.8348L84.7167,98.3921A29.9177,29.9177,0,0,0,98.2353,78.3493,31.5263,31.5263,0,0,0,95.13,58.117a30,30,0,0,0,4.4743-11.1824,31.88,31.88,0,0,0-5.4473-24.1157" style="fill:#ff3e00"/><path d="M45.8171,106.5815A20.7182,20.7182,0,0,1,23.58,98.3389a19.1739,19.1739,0,0,1-3.2766-14.5025,18.1886,18.1886,0,0,1,.6233-2.4357l.4912-1.4978,1.3363.9815a33.6443,33.6443,0,0,0,10.203,5.0978l.9694.2941-.0893.9675a5.8474,5.8474,0,0,0,1.052,3.8781,6.2389,6.2389,0,0,0,6.6952,2.485,5.7449,5.7449,0,0,0,1.6021-.7041L69.27,76.281a5.4306,5.4306,0,0,0,2.4506-3.631,5.7948,5.7948,0,0,0-.9875-4.3712,6.2436,6.2436,0,0,0-6.6978-2.4864,5.7427,5.7427,0,0,0-1.6.7036l-9.9532,6.3449a19.0329,19.0329,0,0,1-5.2965,2.3259,20.7181,20.7181,0,0,1-22.2368-8.2427,19.1725,19.1725,0,0,1-3.2766-14.5024,17.9885,17.9885,0,0,1,8.13-12.0513L55.8833,23.7472a19.0038,19.0038,0,0,1,5.3-2.3287A20.7182,20.7182,0,0,1,83.42,29.6611a19.1739,19.1739,0,0,1,3.2766,14.5025,18.4,18.4,0,0,1-.6233,2.4357l-.4912,1.4978-1.3356-.98a33.6175,33.6175,0,0,0-10.2037-5.1l-.9694-.2942.0893-.9675a5.8588,5.8588,0,0,0-1.052-3.878,6.2389,6.2389,0,0,0-6.6952-2.485,5.7449,5.7449,0,0,0-1.6021.7041L37.73,51.719a5.4218,5.4218,0,0,0-2.4487,3.63,5.7862,5.7862,0,0,0,.9856,4.3717,6.2437,6.2437,0,0,0,6.6978,2.4864,5.7652,5.7652,0,0,0,1.602-.7041l9.9519-6.3425a18.978,18.978,0,0,1,5.2959-2.3278,20.7181,20.7181,0,0,1,22.2368,8.2427,19.1725,19.1725,0,0,1,3.2766,14.5024,17.9977,17.9977,0,0,1-8.13,12.0532L51.1167,104.2528a19.0038,19.0038,0,0,1-5.3,2.3287" style="fill:#fff"/></svg>`;

const reactIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="-11.5 -10.23174 23 20.46348"><title>React Logo</title><circle cx="0" cy="0" r="2.05" fill="#61dafb"/><g stroke="#61dafb" stroke-width="1" fill="none"><ellipse rx="11" ry="4.2"/><ellipse rx="11" ry="4.2" transform="rotate(60)"/><ellipse rx="11" ry="4.2" transform="rotate(120)"/></g></svg>`;
---

<BaseLayout title="Annota - High-performance annotation framework">
  <!-- Hero Section -->
  <section
    class="relative overflow-hidden py-20 lg:py-32"
    style="background: linear-gradient(to bottom right, var(--muted), var(--background));"
  >
    <div class="container mx-auto px-6">
      <div class="max-w-4xl mx-auto text-center">
        <h1
          class="text-5xl md:text-6xl font-bold mb-6"
          style="color: var(--foreground);"
        >
          Annota
        </h1>
        <p class="text-xl md:text-2xl mb-8" style="color: var(--foreground);">
          High-performance annotation framework
        </p>
        <p
          class="text-lg mb-12 max-w-2xl mx-auto"
          style="color: var(--muted-foreground);"
        >
          Build powerful annotation tools with support for both{" "}
          <strong>Svelte</strong> and <strong>React</strong>. Handle thousands
          of annotations at 60 FPS with hardware-accelerated rendering.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/docs"
            class="inline-flex items-center justify-center px-8 py-3 text-base font-medium rounded-lg transition-all duration-200 hover:opacity-90 hover:shadow-lg"
            style="background-color: var(--primary); color: var(--primary-foreground);"
          >
            Get Started
            <ChevronRight class="ml-2 w-5 h-5" />
          </a>
          <a
            href="/playground"
            class="inline-flex items-center justify-center px-8 py-3 text-base font-medium border-2 rounded-lg transition-all duration-200 hover:shadow-md"
            style="border-color: var(--border); color: var(--foreground); background-color: transparent;"
            onmouseover="this.style.backgroundColor='var(--muted)'"
            onmouseout="this.style.backgroundColor='transparent'"
          >
            Playground
            <MonitorPlay class="ml-2 w-5 h-5" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-20" style="background-color: var(--background);">
    <div class="container mx-auto px-6">
      <h2
        class="text-3xl md:text-4xl font-bold text-center mb-12"
        style="color: var(--foreground);"
      >
        Why Choose Annota?
      </h2>
      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto"
      >
        <FeatureCard
          client:load
          iconName="Zap"
          title="High Performance"
          description="60 FPS rendering with hardware acceleration, viewport culling, and R-tree spatial indexing"
        />
        <FeatureCard
          client:load
          iconName="Code2"
          title="Svelte & React"
          description="Works seamlessly with both Svelte 5 and React 18+. Choose the framework that fits your stack"
        />
        <FeatureCard
          client:load
          iconName="Layers"
          title="Multi-Layer Support"
          description="Organize annotations into layers with independent visibility, opacity, and styling controls"
        />
        <FeatureCard
          client:load
          iconName="Package"
          title="Comprehensive Tools"
          description="Point, rectangle, polygon, freehand, and SAM segmentation tools out of the box"
        />
        <FeatureCard
          client:load
          iconName="Microscope"
          title="Pathology-Focused"
          description="Built specifically for whole slide imaging and digital pathology workflows"
        />
        <FeatureCard
          client:load
          iconName="Brain"
          title="Event-Driven"
          description="Comprehensive event system for responding to annotation changes in real-time"
        />
      </div>
    </div>
  </section>

  <!-- Interactive Demo Section -->
  <section class="py-20" style="background-color: var(--muted);">
    <div class="container mx-auto px-6">
      <div class="max-w-4xl mx-auto">
        <h2
          class="text-3xl md:text-4xl font-bold text-center mb-4"
          style="color: var(--foreground);"
        >
          Try It Now
        </h2>
        <p class="text-center mb-8" style="color: var(--muted-foreground);">
          Interactive demo: Click and drag to draw a rectangle annotation, or
          select and resize the existing one.
        </p>
        <div
          class="rounded-lg shadow-lg p-4 h-[500px]"
          style="background-color: var(--background);"
        >
          <AnnotaDemo client:only="svelte" />
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Start Section -->
  <section class="py-20" style="background-color: var(--background);">
    <div class="container mx-auto px-6">
      <div class="max-w-3xl mx-auto">
        <h2
          class="text-3xl md:text-4xl font-bold text-center mb-8"
          style="color: var(--foreground);"
        >
          Quick Start
        </h2>
        <FrameworkTabs
          items={[
            { label: "Svelte", icon: svelteIcon },
            { label: "React", icon: reactIcon },
          ]}
        >
          <FrameworkTab>
            <div class="rounded-lg p-6" style="background-color: var(--muted);">
              <Code
                code={`import { AnnotaProvider, Viewer, Annotator, tool } from 'annota/svelte';
import { RectangleTool } from 'annota';

<script lang="ts">
  import { AnnotaProvider, Viewer, Annotator, tool } from 'annota/svelte';
  import { RectangleTool } from 'annota';
  
  let viewer: OpenSeadragon.Viewer | undefined = $state(undefined);
  const rectangleTool = new RectangleTool();
  
  tool({
    viewer: () => viewer,
    handler: () => rectangleTool,
    enabled: () => !!viewer,
  });
</script>

<AnnotaProvider slideId="my-slide">
  <Viewer
    options={{ tileSources: "/image.dzi" }}
    onViewerReady={(v) => viewer = v}
  />
  <Annotator viewer={viewer} />
</AnnotaProvider>`}
                lang="svelte"
              />
            </div>
          </FrameworkTab>
          <FrameworkTab>
            <div class="rounded-lg p-6" style="background-color: var(--muted);">
              <Code
                code={`import { AnnotaProvider, AnnotaViewer, Annotator } from 'annota';
import { useTool } from 'annota';
import { RectangleTool } from 'annota';
import { useState } from 'react';

function App() {
  const [viewer, setViewer] = useState(null);
  const rectangleTool = new RectangleTool();
  
  useTool({
    viewer,
    handler: rectangleTool,
    enabled: !!viewer,
  });

  return (
    <AnnotaProvider slideId="my-slide">
      <AnnotaViewer
        options={{ tileSources: "/image.dzi" }}
        onViewerReady={setViewer}
      />
      <Annotator viewer={viewer} />
    </AnnotaProvider>
  );
}`}
                lang="tsx"
              />
            </div>
          </FrameworkTab>
        </FrameworkTabs>
        <div class="text-center mt-8">
          <a
            href="/docs/getting-started/quick-start"
            class="inline-flex items-center hover:underline transition-all"
            style="color: var(--primary);"
          >
            Read the full guide
            <ChevronRight class="ml-1 w-4 h-4" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section
    class="py-16"
    style="background: linear-gradient(to bottom right, var(--primary), color-mix(in srgb, var(--primary) 80%, var(--background))); color: var(--primary-foreground);"
  >
    <div class="container mx-auto px-6 text-center">
      <h2
        class="text-3xl md:text-4xl font-semibold mb-4"
        style="color: var(--primary-foreground);"
      >
        Ready to Start Annotating?
      </h2>
      <p
        class="text-base mb-8 max-w-xl mx-auto"
        style="color: var(--primary-foreground); opacity: 0.9;"
      >
        Build powerful annotation tools for digital pathology with Annota's
        comprehensive framework
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href="/docs"
          class="inline-flex items-center justify-center px-6 py-2.5 text-sm font-medium rounded-lg transition-all duration-200 hover:opacity-90"
          style="background-color: var(--primary-foreground); color: var(--primary);"
        >
          Read Documentation
          <ChevronRight class="ml-2 w-4 h-4" />
        </a>
        <a
          href="/api"
          class="inline-flex items-center justify-center px-6 py-2.5 text-sm font-medium border rounded-lg transition-all duration-200 hover:bg-white/10"
          style="border-color: var(--primary-foreground); color: var(--primary-foreground);"
        >
          API
        </a>
      </div>
    </div>
  </section>

  <Footer client:load />
</BaseLayout>
