---
const options = [
  { value: "auto", label: "Auto" },
  { value: "light", label: "Light" },
  { value: "dark", label: "Dark" },
];
---

<div class="theme-switcher" data-theme-switcher>
  <button class="theme-trigger" type="button" aria-haspopup="menu" aria-expanded="false">
    <span class="theme-icon" aria-hidden="true">
      <svg class="theme-icon-auto" viewBox="0 0 24 24">
        <rect x="3" y="5" width="18" height="12" rx="2" ry="2"></rect>
        <line x1="8" y1="20" x2="16" y2="20"></line>
      </svg>
      <svg class="theme-icon-light" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="4"></circle>
        <line x1="12" y1="2" x2="12" y2="5"></line>
        <line x1="12" y1="19" x2="12" y2="22"></line>
        <line x1="2" y1="12" x2="5" y2="12"></line>
        <line x1="19" y1="12" x2="22" y2="12"></line>
        <line x1="4.9" y1="4.9" x2="7" y2="7"></line>
        <line x1="17" y1="17" x2="19.1" y2="19.1"></line>
        <line x1="4.9" y1="19.1" x2="7" y2="17"></line>
        <line x1="17" y1="7" x2="19.1" y2="4.9"></line>
      </svg>
      <svg class="theme-icon-dark" viewBox="0 0 24 24">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
      </svg>
    </span>
    <span class="theme-label">Auto</span>
    <svg class="theme-caret" viewBox="0 0 24 24" aria-hidden="true">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>

  <div class="theme-menu" role="menu" hidden>
    {
      options.map((option) => (
        <button
          class="theme-option"
          type="button"
          role="menuitemradio"
          aria-checked={option.value === "auto" ? "true" : "false"}
          data-theme-option={option.value}
        >
          <span>{option.label}</span>
        </button>
      ))
    }
  </div>
</div>

<script>
  type Theme = "auto" | "light" | "dark";

  const storageKey = "starlight-theme";
  const mediaQuery = window.matchMedia("(prefers-color-scheme: light)");

  const parseTheme = (value: unknown): Theme =>
    value === "dark" || value === "light" || value === "auto" ? value : "auto";

  const loadTheme = (): Theme => parseTheme(localStorage.getItem(storageKey));

  const effectiveTheme = (theme: Theme): "light" | "dark" => {
    if (theme === "auto") {
      return mediaQuery.matches ? "light" : "dark";
    }
    return theme;
  };

  const labels: Record<Theme, string> = {
    auto: "Auto",
    light: "Light",
    dark: "Dark",
  };

  const switchers = Array.from(
    document.querySelectorAll<HTMLElement>("[data-theme-switcher]:not([data-theme-switcher-init])")
  );

  const setOpen = (switcher: HTMLElement, open: boolean) => {
    const trigger = switcher.querySelector<HTMLButtonElement>(".theme-trigger");
    const menu = switcher.querySelector<HTMLElement>(".theme-menu");
    if (!trigger || !menu) return;
    trigger.setAttribute("aria-expanded", open ? "true" : "false");
    switcher.dataset.open = open ? "true" : "false";
    menu.hidden = !open;
  };

  const updateSwitcher = (switcher: HTMLElement, theme: Theme) => {
    switcher.dataset.theme = theme;
    const label = switcher.querySelector<HTMLElement>(".theme-label");
    if (label) {
      label.textContent = labels[theme];
    }
    switcher.querySelectorAll<HTMLElement>(".theme-option").forEach((option) => {
      option.setAttribute(
        "aria-checked",
        option.dataset.themeOption === theme ? "true" : "false"
      );
    });
  };

  const applyTheme = (theme: Theme, persist = true, broadcast = true) => {
    const active = effectiveTheme(theme);
    document.documentElement.dataset.theme = active;
    document.documentElement.classList.toggle("dark", active === "dark");
    if (persist) {
      localStorage.setItem(storageKey, theme === "auto" ? "" : theme);
    }
    switchers.forEach((switcher) => updateSwitcher(switcher, theme));
    if (broadcast) {
      window.dispatchEvent(
        new CustomEvent("theme-change", { detail: { theme, effectiveTheme: active } })
      );
    }
  };

  const initialTheme = loadTheme();
  applyTheme(initialTheme, false, false);

  switchers.forEach((switcher) => {
    switcher.dataset.themeSwitcherInit = "true";
    const trigger = switcher.querySelector<HTMLButtonElement>(".theme-trigger");
    const menu = switcher.querySelector<HTMLElement>(".theme-menu");
    if (!trigger || !menu) return;

    trigger.addEventListener("click", (event) => {
      event.stopPropagation();
      const isOpen = switcher.dataset.open === "true";
      switchers.forEach((item) => item !== switcher && setOpen(item, false));
      setOpen(switcher, !isOpen);
    });

    menu.querySelectorAll<HTMLButtonElement>(".theme-option").forEach((option) => {
      option.addEventListener("click", () => {
        const nextTheme = parseTheme(option.dataset.themeOption);
        applyTheme(nextTheme);
        setOpen(switcher, false);
      });
    });

    setOpen(switcher, false);
    updateSwitcher(switcher, initialTheme);
  });

  document.addEventListener("click", () => {
    switchers.forEach((switcher) => setOpen(switcher, false));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      switchers.forEach((switcher) => setOpen(switcher, false));
    }
  });

  window.addEventListener("storage", (event) => {
    if (event.key === storageKey) {
      applyTheme(loadTheme(), false, false);
    }
  });

  mediaQuery.addEventListener("change", () => {
    if (loadTheme() === "auto") {
      applyTheme("auto", false, true);
    }
  });
</script>

<style>
  .theme-switcher {
    position: relative;
    color: var(--sl-color-gray-2);
  }

  .theme-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.25rem;
    padding: 6px 12px;
    border-radius: 0.65rem;
    border: 1px solid var(--sl-color-hairline);
    background: color-mix(in oklab, var(--sl-color-bg-nav) 88%, var(--sl-color-gray-6));
    color: inherit;
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
    transition:
      color 0.15s ease,
      background-color 0.15s ease,
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .theme-trigger:hover {
    color: var(--sl-color-text);
    border-color: var(--sl-color-gray-5);
    background: var(--sl-color-gray-6);
  }

  .theme-trigger:focus-visible {
    outline: none;
    border-color: var(--sl-color-accent);
    box-shadow: 0 0 0 2px rgb(59 130 246 / 0.25);
  }

  .theme-icon {
    width: 0.95rem;
    height: 0.95rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .theme-icon svg {
    width: 100%;
    height: 100%;
    display: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .theme-switcher[data-theme="auto"] .theme-icon-auto,
  .theme-switcher[data-theme="light"] .theme-icon-light,
  .theme-switcher[data-theme="dark"] .theme-icon-dark {
    display: block;
  }

  .theme-label {
    min-width: 2.75rem;
    text-align: left;
    font-size: 0.86rem;
  }

  .theme-caret {
    width: 0.92rem;
    height: 0.92rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.15s ease;
  }

  .theme-switcher[data-open="true"] .theme-caret {
    transform: rotate(180deg);
  }

  .theme-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 0.45rem);
    min-width: 8.5rem;
    padding: 0.3rem;
    border-radius: 0.7rem;
    border: 1px solid var(--sl-color-hairline);
    background: var(--sl-color-bg-nav);
    box-shadow: 0 16px 30px -16px rgb(2 6 23 / 0.45);
    z-index: 80;
  }

  .theme-option {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: 0.42rem 0.55rem;
    border: 0;
    border-radius: 0.5rem;
    background: transparent;
    color: var(--sl-color-gray-2);
    font-size: 0.84rem;
    font-weight: 500;
    cursor: pointer;
  }

  .theme-option:hover {
    color: var(--sl-color-text);
    background: var(--sl-color-gray-6);
  }

  .theme-option[aria-checked="true"] {
    color: var(--sl-color-text);
    background: color-mix(in oklab, var(--sl-color-gray-6) 68%, transparent);
  }
</style>
