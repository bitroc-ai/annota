---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/Header.astro';
---

<Default {...Astro.props}><slot /></Default>

<style>
  /* Add navigation links after the site title */
  :global(header.header) {
    position: relative;
  }
</style>

<script>
  // Add navigation links to the header
  function addNavLinks() {
    const header = document.querySelector('header.header');
    if (!header) return;
    
    // Check if nav already exists
    if (header.querySelector('.custom-nav')) return;
    
    const siteTitle = header.querySelector('.site-title');
    if (!siteTitle) return;
    
    // Create nav element
    const nav = document.createElement('nav');
    nav.className = 'custom-nav';
    nav.setAttribute('aria-label', 'Main navigation');
    
    const links = [
      { href: '/', label: 'Home' },
      { href: '/getting-started/installation', label: 'Docs' },
      { href: '/playground', label: 'Playground' },
      { href: '/api', label: 'API' },
    ];
    
    links.forEach(({ href, label }) => {
      const link = document.createElement('a');
      link.href = href;
      link.textContent = label;
      link.className = 'nav-link';
      
      // Check if current page
      const currentPath = window.location.pathname;
      if (href === '/' && currentPath === '/') {
        link.setAttribute('aria-current', 'page');
      } else if (href !== '/' && currentPath.startsWith(href.replace(/\/$/, ''))) {
        link.setAttribute('aria-current', 'page');
      }
      
      nav.appendChild(link);
    });
    
    // Insert after site title
    siteTitle.parentNode?.insertBefore(nav, siteTitle.nextSibling);
  }
  
  // Run on page load
  addNavLinks();
  
  // Run on Astro page transitions
  document.addEventListener('astro:page-load', addNavLinks);
</script>

<style is:global>
  .custom-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: 1.5rem;
  }
  
  .custom-nav .nav-link {
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    border-radius: 0.375rem;
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  
  .custom-nav .nav-link:hover {
    color: var(--sl-color-white);
    background-color: var(--sl-color-gray-6);
  }
  
  .custom-nav .nav-link[aria-current="page"] {
    color: var(--sl-color-white);
    background-color: var(--sl-color-gray-5);
  }
  
  /* Hide on mobile */
  @media (max-width: 50rem) {
    .custom-nav {
      display: none;
    }
  }
</style>

