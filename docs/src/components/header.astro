---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/Header.astro';
---

<Default {...Astro.props}><slot /></Default>

<style>
  /* Add navigation links after the site title */
  :global(header.header) {
    position: relative;
  }

  /* Prevent header flickering during transitions */
  :global(header.header) {
    view-transition-name: header;
  }
</style>

<script>
  // Add navigation links to the header (only creates if doesn't exist)
  function addNavLinks() {
    const header = document.querySelector('header.header');
    if (!header) return;

    const siteTitle = header.querySelector('.site-title');
    if (!siteTitle) return;

    // Check if nav already exists
    let nav = header.querySelector('.custom-nav');

    // If nav doesn't exist, create it
    if (!nav) {
      nav = document.createElement('nav');
      nav.className = 'custom-nav';
      nav.setAttribute('aria-label', 'Main navigation');

      const links = [
        { href: '/', label: 'Home' },
        { href: '/getting-started/installation', label: 'Docs' },
        { href: '/playground', label: 'Playground' },
        { href: '/api', label: 'API' },
      ];

      links.forEach(({ href, label }) => {
        const link = document.createElement('a');
        link.href = href;
        link.textContent = label;
        link.className = 'nav-link';
        link.dataset.href = href; // Store href for updating active state
        nav.appendChild(link);
      });

      // Insert after site title
      siteTitle.parentNode?.insertBefore(nav, siteTitle.nextSibling);
    }

    // Update active state for existing nav
    const currentPath = window.location.pathname;
    nav.querySelectorAll('.nav-link').forEach(link => {
      const href = link.dataset.href || link.getAttribute('href');
      link.removeAttribute('aria-current');

      if (href === '/' && currentPath === '/') {
        link.setAttribute('aria-current', 'page');
      } else if (href !== '/' && currentPath.startsWith(href.replace(/\/$/, ''))) {
        link.setAttribute('aria-current', 'page');
      }
    });
  }

  // Run on page load
  addNavLinks();

  // Run on Astro page transitions (updates active state without recreation)
  document.addEventListener('astro:page-load', addNavLinks);
</script>

<style is:global>
  .custom-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: 1.5rem;
  }
  
  .custom-nav .nav-link {
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    border-radius: 0.375rem;
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  
  .custom-nav .nav-link:hover {
    color: var(--sl-color-white);
    background-color: var(--sl-color-gray-6);
  }
  
  .custom-nav .nav-link[aria-current="page"] {
    color: var(--sl-color-white);
    background-color: var(--sl-color-gray-5);
  }
  
  /* Hide on mobile */
  @media (max-width: 50rem) {
    .custom-nav {
      display: none;
    }
  }
</style>

